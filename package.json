{
  "name": "job-pulse-realtime",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "crawler:dev": "wrangler dev --config wrangler.crawler.local.jsonc --test-scheduled",
    "crawler:audit": "node scripts/audit-crawler-coverage.ts",
    "crawler:audit:browser": "node scripts/browser-url-audit.ts",
    "crawler:audit:apply": "node scripts/apply-browser-url-audit.ts",
    "crawler:fallback:browser": "node scripts/browser-fallback-crawl.ts",
    "jobs:topic:audit": "node scripts/audit-ai-data-topic.ts",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:html": "npm run build && node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern .codex_tmp --ignore-pattern output",
    "db:generate": "drizzle-kit generate",
    "db:seed:build": "node scripts/build-source-seed.ts",
    "db:catalog:refresh": "node scripts/build-source-seed.ts --migration",
    "db:migrate:local": "wrangler d1 migrations apply site-creator-d1 --config wrangler.local.jsonc --local --persist-to .wrangler/state",
    "db:seed:local": "wrangler d1 execute site-creator-d1 --config wrangler.local.jsonc --local --persist-to .wrangler/state --file db/seed/sources.sql",
    "db:verify:local": "wrangler d1 execute site-creator-d1 --config wrangler.local.jsonc --local --persist-to .wrangler/state --json --command 'SELECT (SELECT count(*) FROM sources) AS sources, (SELECT count(*) FROM talent_targets) AS talent_targets, (SELECT count(*) FROM sources WHERE posting_url IS NOT NULL) AS posting_urls, (SELECT count(*) FROM sources WHERE talent_url IS NOT NULL) AS talent_urls'",
    "sites:stage": "node scripts/prepare-sites-package.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.55.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
